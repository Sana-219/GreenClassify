{
  "buildCommand": "pip install -r requirements.txt",
  "outputDirectory": ".",
  "framework": "flask",
  "functions": {
    "flask/app.py": {
      "memory": 3008,
      "maxDuration": 60
    }
  },
  "env": {
    "PYTHONUNBUFFERED": "1"
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/flask/app.py" },
    { "source": "/(.*)", "destination": "/flask/app.py" }
  ]
}
